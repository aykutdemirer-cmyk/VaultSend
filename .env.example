# --- Database ---
POSTGRES_USER=securetransfer
POSTGRES_PASSWORD=change_me
POSTGRES_DB=securetransfer
DATABASE_URL=postgresql+psycopg://securetransfer:change_me@db:5432/securetransfer

# --- App ---
APP_SECRET_KEY=change_me_to_a_long_random_string
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
ENVIRONMENT=development

# --- Marka (her müşteri için değiştirebilirsiniz, backend restart yeterli) ---
BRAND_NAME=VaultSend

# --- Defaults (overridable from Admin Panel -> Ayarlar, DB value wins if set) ---
MAX_FILE_SIZE_GB=10
DEFAULT_LINK_TTL_HOURS=24
MAX_LINK_TTL_HOURS=168
MAX_DOWNLOADS=0
EXPIRED_RETENTION_HOURS=24
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.ps1,.vbs,.scr,.dll

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Storage ---
STORAGE_PATH=/data/uploads

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=VaultSend <no-reply@firma.com>
SMTP_TLS=true

# --- Admin bootstrap (only used the first time the DB has zero admins) ---
ADMIN_BOOTSTRAP_EMAIL=admin@firma.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_admin_password
